import numpy as np
import matplotlib.pyplot as plt
from keras.datasets import mnist
from keras.models import Model
from keras.layers import Input, Dense
from keras.optimizers import Adam
from sklearn.manifold import TSNE

# Load and pre-process the mnist model
(x_train, y_train), (x_test, y_test) = mnist.load_data()

# Normalize the dataset to range between 0 and 1
x_train = x_train.astype("float32")/255.
x_test = x_test.astype("float32")/255.

# Flattening the image into vectors
x_train = x_train.reshape((len(x_train), np.prod(x_train.shape[1:])))
x_test = x_test.reshape((len(x_test), np.prod(x_test.shape[1:])))

# Building the autoencoder model

# Defining the encoding dimension
encoding_dim = 32

# Defining the input 
input_img = Input(shape=(784,))

# Defining the encoder model
encoded = Dense(encoding_dim, activation='relu')(input_img)

# Defining the decoder model
decoded = Dense(784, activation='sigmoid')(encoded)

# Combining the models together
autoencoder = Model(input_img, decoded)

# Creating a separate encoder model
encoder = Model(input_img, encoded)

# Creating the decoder model separately
encoded_input = Input(shape=(encoding_dim,))
decoder_layer = autoencoder.layers[-1]
decoder = Model(encoded_input, decoder_layer(encoded_input))

# Compiling the autoencoder 
autoencoder.compile(optimizer='adam', loss='binary_crossentropy')

# Training the autoencoder
history = autoencoder.fit(x_train, x_train,
                          epochs = 50,
                          batch_size=256,
                          shuffle=True,
                          validation_data = (x_test,x_test)
                         )

# Predict (reconstructed images)
decoded_img = autoencoder.predict(x_test)

# Visualizing original and reconstructed images
n = 10
plt.figure(figsize=(20,4))
for i in range(n):
    ax = plt.subplot(2,n,i+1)
    plt.imshow(x_test[i].reshape(28,28))
    plt.gray()
    ax.get_xaxis().set_visible(False)
    ax.get_yaxis().set_visible(False)
    if i == 0:
        ax.set_title('Original Images', loc='left')

    ax = plt.subplot(2,n,i+1+n)
    plt.imshow(decoded_img[i].reshape(28,28))
    plt.gray()
    ax.get_xaxis().set_visible(False)
    ax.get_yaxis().set_visible(False)
    if i == 0:
        ax.set_title('Reconstructed Images', loc='left')
plt.show()

# Visualizing the latent space using t-SNE

# Encode the test data
encoded_img = encoder.predict(x_test)

# Reduce to 2d for visualization
tsne = TSNE(n_components=2, random_state=42)
encoded_img2d = tsne.fit_transform(encoded_img)

# Plot the 2d latent space 
plt.figure(figsize=(12,10))
plt.scatter(encoded_img2d[:,0], encoded_img2d[:,1], c=y_test, cmap='jet', s=10)
plt.colorbar()
plt.title('t-SNE visualization of the mnist latent space')
plt.xlabel('t-SNE dimension 1')
plt.ylabel('t-SNE dimension 2')
plt.show()

